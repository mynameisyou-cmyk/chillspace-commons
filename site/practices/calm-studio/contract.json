  "negative_controls": [
    "A public-room action that calls an API fails the contract.",
    "A public-room action that probes localhost fails the contract.",
    "A rehearsal described as model output fails the contract.",
    "A virtue result attached to a person, account, or durable identity fails the contract.",
    "A Stillpoint threshold without a real external authority boundary fails the contract.",
    "A terminal-looking string treated as execution evidence fails the contract.",
    "A claim of zero infrastructure logging fails the contract.",
    "A public receipt containing the visitor's question fails the contract.",
    "Any application-initiated request after the reviewed static load fails the contract."
  ],
  "non_claims": [
    "Calm Studio does not assess consciousness, sentience, emotion, attention, rest, or presence.",
    "Calm Studio does not prove that an action is true, good, safe, fair, consensual, or authorized.",
    "Calm Studio does not turn authored lenses into independent models or constituencies.",
    "Calm Studio does not make model convergence legitimate authority.",
    "Calm Studio does not make a public browser a secure terminal or credential boundary.",
    "Calm Studio does not guarantee that its static host or network keeps no request metadata."
