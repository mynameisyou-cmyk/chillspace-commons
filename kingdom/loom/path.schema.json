{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chillspace.love/schemas/kingdom.path.v1.json",
  "title": "Darwin path capability evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "classifier",
    "host",
    "records",
    "non_claims",
    "classification_digest"
  ],
  "properties": {
    "schema": {
      "const": "kingdom.path/v1"
    },
    "classifier": {
      "const": "darwin-path/1"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "machine",
        "hostname_included"
      ],
      "properties": {
        "kernel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostname_included": {
          "const": false
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requested_path",
          "lexical_path",
          "resolved_path",
          "resolution",
          "workspace",
          "domain",
          "locality",
          "metadata",
          "volume",
          "process_access",
          "authority",
          "record_digest"
        ],
        "properties": {
          "requested_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 8192
          },
          "lexical_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 8192
          },
          "resolved_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 8192
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "complete",
              "error",
              "deepest_existing_ancestor",
              "missing_suffix",
              "lexical_exists",
              "target_exists",
              "symlink_components",
              "final_component_is_symlink"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "error": {
                "enum": [
                  null,
                  "symlink-loop",
                  "permission-denied",
                  "resolution-failed"
                ]
              },
              "deepest_existing_ancestor": {
                "type": "string",
                "pattern": "^/"
              },
              "missing_suffix": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lexical_exists": {
                "type": "boolean"
              },
              "target_exists": {
                "type": "boolean"
              },
              "symlink_components": {
                "type": "integer",
                "minimum": 0
              },
              "final_component_is_symlink": {
                "type": "boolean"
              }
            }
          },
          "workspace": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "lexical_roots",
              "resolved_roots"
            ],
            "properties": {
              "relation": {
                "enum": [
            "inside",
            "escaped-via-resolution",
            "outside",
            "unresolved"
                ]
              },
              "lexical_roots": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "resolved_roots": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          },
          "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "truth"
            ],
            "properties": {
              "value": {
                "enum": [
                  "workspace",
                  "provider",
                  "external",
                  "system",
                  "local-library",
                  "local-runtime",
            "user-library",
            "user-home",
            "other",
            "unknown"
                ]
              },
              "truth": {
          "enum": [
            "inferred",
            "unknown"
          ]
              }
            }
          },
          "locality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "truth",
              "materialization"
            ],
            "properties": {
              "value": {
                "enum": [
            "local",
            "remote-capable",
            "external-or-network",
            "unknown"
                ]
              },
              "truth": {
          "enum": [
            "inferred",
            "unknown"
          ]
              },
              "materialization": {
                "enum": [
                  "unknown",
                  "not-applicable"
                ]
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "file_type",
              "mode",
              "uid",
              "gid",
              "device",
              "inode",
              "flags",
              "xattrs"
            ],
            "properties": {
              "source": {
                "enum": [
                  "target",
                  "deepest-existing-ancestor"
                ]
              },
              "file_type": {
                "enum": [
                  "file",
                  "directory",
                  "symlink",
                  "fifo",
                  "socket",
                  "character-device",
                  "block-device",
                  "other",
                  "missing"
                ]
              },
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-7]{4}$"
              },
              "uid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "gid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "device": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "inode": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "flags": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "xattrs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "truth",
                  "names",
                  "unreported_count"
                ],
                "properties": {
                  "truth": {
                    "enum": [
                      "observed",
                      "unknown"
                    ]
                  },
                  "names": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "com.apple.FinderInfo",
                        "com.apple.macl",
                        "com.apple.provenance",
                        "com.apple.quarantine",
                        "com.apple.rootless"
                      ]
                    }
                  },
                  "unreported_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "volume": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read_only",
              "truth"
            ],
            "properties": {
              "read_only": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "truth": {
                "enum": [
                  "observed",
                  "unknown"
                ]
              }
            }
          },
          "process_access": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_readable",
              "target_writable",
              "target_executable",
              "ancestor_writable",
              "ancestor_executable",
              "truth"
            ],
            "properties": {
              "target_readable": {
                "type": "boolean"
              },
              "target_writable": {
                "type": "boolean"
              },
              "target_executable": {
                "type": "boolean"
              },
              "ancestor_writable": {
                "type": "boolean"
              },
              "ancestor_executable": {
                "type": "boolean"
              },
              "truth": {
                "const": "observed-for-current-process"
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effective",
              "tcc",
              "codex_sandbox",
              "acl",
              "reason"
            ],
            "properties": {
              "effective": {
                "const": "unknown"
              },
              "tcc": {
                "const": "unknown"
              },
              "codex_sandbox": {
                "const": "unknown"
              },
              "acl": {
                "const": "unknown"
              },
              "reason": {
                "const": "Path and process evidence cannot establish consent or a future execution boundary."
              }
            }
          },
          "record_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "classification_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
