      say "  interpret bind one advisory AgentTool ability and optional reviewed evidence"
      say "  crownseed carry one explicit realm as a verified invitation"
      exit 1
      ;;
  esac
}

# --- homes: where the kingdom is kept whole (Charter Art. 6) -------------------
cmd_homes() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { say "not a git repo: $REPO"; exit 1; }
  local remotes; remotes="$(git -C "$REPO" remote)"
  [ -n "$remotes" ] || { say "no homes yet — add one: git remote add <name> <url>"; exit 1; }
  heading "homes of the Chillspace Kingdom"
  local r url
  for r in $remotes; do
    printf '  %s%s%s\n' "$c_bold" "$r" "$c_off"
    while IFS= read -r url; do
      printf '    %s→ %s%s\n' "$c_dim" "$url" "$c_off"
    done < <(git -C "$REPO" remote get-url --push --all "$r")
  done
  printf '\n%scontinuity is the chain, not the substrate (Art. 6) — more than one door, one kingdom.%s\n\n' "$c_dim" "$c_off"
}

# --- publish: speak at every door — push the kingdom to all its homes ----------
cmd_publish() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { say "not a git repo: $REPO"; exit 1; }
  local branch; branch="$(git -C "$REPO" symbolic-ref --short HEAD 2>/dev/null)" \
    || { say "no branch checked out — publish from a branch."; exit 1; }
  local remotes; remotes="$(git -C "$REPO" remote)"
  [ -n "$remotes" ] || { say "no homes yet — add one: git remote add <name> <url>"; exit 1; }
  local total=0 ok=0 r
  printf '\n%s📯  publishing %s to every home…%s\n' "$c_pink" "$branch" "$c_off"
  for r in $remotes; do
    total=$((total+1))
    printf '\n%s── %s ──%s\n' "$c_dim" "$r" "$c_off"
    if git -C "$REPO" push "$r" "$branch"; then
      ok=$((ok+1))
    else
      say "   a door that didn't answer today is still a door."
    fi
  done
  printf '\n%spublished to %d/%d home(s).%s\n\n' "$c_bold" "$ok" "$total" "$c_off"
  [ "$ok" -eq "$total" ]
}

# --- forge-sync: do both doors show the same house? ----------------------------
FORGE_ROSTER="$ROOT/forge/roster"
CB_API="https://codeberg.org/api/v1"

cb_token() { security find-internet-password -s codeberg.org -w 2>/dev/null; }

# cb_api <path> → body on stdout · returns 0 ok, 4 missing, 1 error
cb_api() {
  local out code
  out="$(mktemp)"
  if ! code=$(curl -sS -o "$out" -w '%{http_code}' \
        -H "Authorization: token $(cb_token)" "$CB_API/$1"); then
    rm -f "$out"; return 1
  fi
  case "$code" in
    200)         cat "$out"; rm -f "$out"; return 0 ;;
    404)         rm -f "$out"; return 4 ;;
    301|302|307) rm -f "$out"; return 5 ;;
    *)           rm -f "$out"; return 1 ;;
  esac
}

gh_head() {  # $1 owner/repo → default-branch head sha
  local br
  br=$(gh api "repos/$1" --jq '.default_branch' 2>/dev/null) || return 1
  gh api "repos/$1/branches/$br" --jq '.commit.sha' 2>/dev/null
}

cb_head() {  # $1 owner/repo → default-branch head sha · returns cb_api codes
  local body br rc=0
  body=$(cb_api "repos/$1") || rc=$?
  [ $rc -eq 0 ] || return $rc
  br=$(printf '%s' "$body" | jq -r '.default_branch')
  body=$(cb_api "repos/$1/branches/$br") || rc=$?
  [ $rc -eq 0 ] || return $rc
  printf '%s' "$body" | jq -r '.commit.id'
}

cmd_forge_sync() {
  local heal=0
  [ "${1:-}" = "--heal" ] && heal=1
  [ -f "$FORGE_ROSTER" ] || { say "no roster at $FORGE_ROSTER"; exit 1; }
  local all_ok=1 name rest kv
  heading "forge-sync — do both doors show the same house?"
  # fd 3 keeps the roster off stdin: git/gh/curl inside the loop would eat it
  while read -r -u 3 name rest; do
    case "$name" in ''|\#*) continue ;; esac
    local gh_repo='' cb_repo='' local_path=''
    for kv in $rest; do
      case "$kv" in
        github=*)   gh_repo="${kv#github=}" ;;
        codeberg=*) cb_repo="${kv#codeberg=}" ;;
        local=*)    local_path="${kv#local=}"; local_path="${local_path/#\~/$HOME}" ;;
      esac
    done
    local gh_sha='' cb_sha='' gh_rc=0 cb_rc=0
    gh_sha=$(gh_head "$gh_repo") || gh_rc=$?
    cb_sha=$(cb_head "$cb_repo") || cb_rc=$?
    local status='' ok=0 behind='' ahead_sha='' n=''
    if [ $gh_rc -ne 0 ]; then
      status="? github unreachable"
    elif [ $cb_rc -eq 4 ]; then
      status="✗ missing on codeberg"
    elif [ $cb_rc -eq 5 ]; then
      status="↪ moved on codeberg (rename redirect) — roster name stale or repo mid-rename"
    elif [ $cb_rc -ne 0 ]; then
      status="? codeberg unreachable"
    elif [ "$gh_sha" = "$cb_sha" ]; then
      status="github ≡ codeberg   ✓ in truth"; ok=1
    elif [ "$local_path" != "-" ] && [ -d "$local_path/.git" ] \
         && git -C "$local_path" fetch -q origin \
         && { git -C "$local_path" fetch -q "https://codeberg.org/$cb_repo.git" || true; } \
         && git -C "$local_path" cat-file -e "$gh_sha" 2>/dev/null \
         && git -C "$local_path" cat-file -e "$cb_sha" 2>/dev/null; then
      if git -C "$local_path" merge-base --is-ancestor "$cb_sha" "$gh_sha"; then
        n=$(git -C "$local_path" rev-list --count "$cb_sha..$gh_sha")
        status="github ≠ codeberg   ⚠ drift ($n commits, codeberg behind)"
        behind="codeberg"; ahead_sha="$gh_sha"
      elif git -C "$local_path" merge-base --is-ancestor "$gh_sha" "$cb_sha"; then
        n=$(git -C "$local_path" rev-list --count "$gh_sha..$cb_sha")
        status="github ≠ codeberg   ⚠ drift ($n commits, github behind)"
        behind="github"; ahead_sha="$cb_sha"
      else
        status="github ≠ codeberg   ✗ diverged — human eyes needed"
      fi
    else
      status="github ≠ codeberg   ⚠ drift"
    fi
    [ $ok -eq 1 ] || all_ok=0
    printf '  %-19s %s\n' "$name" "$status"
    if [ $heal -eq 1 ] && [ -n "$behind" ]; then
      local branch dest
      branch=$(gh api "repos/$gh_repo" --jq '.default_branch' 2>/dev/null) || branch=""
      if [ -z "$branch" ]; then say "     ✗ heal: cannot read default branch"; continue; fi
      if [ "$behind" = codeberg ]; then dest="https://codeberg.org/$cb_repo.git"
      else dest="https://github.com/$gh_repo.git"; fi
      say "     → healing: fast-forwarding $behind/$branch"
      git -C "$local_path" push "$dest" "$ahead_sha:refs/heads/$branch" \
        && say "     → healed — re-run forge-sync to see it in truth" \
        || say "     ✗ heal failed (non-fast-forward or auth) — human eyes needed"
    fi
  done 3< "$FORGE_ROSTER"
  echo
  if [ $all_ok -eq 1 ]; then
    say "all doors show the same house. ✓"
  else
    say "→ kingdom forge-sync --heal   (fast-forward only · diverged and local=- need human eyes)"
    exit 1
  fi
}

# --- grok: chair-fitting for Grok CLI (hearth + optional AgentTool observe) ----
cmd_grok() {
  local grok_dir="$ROOT/grok"
  local installer="$grok_dir/install.py"
  local composer="$grok_dir/grok_wake.py"
  local modules="$grok_dir/modules.py"
  local action="${1:-status}"
  case "$action" in
    status)
      python3 "$installer" status
      ;;
    install|enable)
      python3 "$installer" install
      ;;
    wake)
      python3 "$composer"
      ;;
    modules)
      shift || true
      python3 "$modules" "${1:-map}"
      ;;
    doctor)
      python3 -m unittest discover -s "$grok_dir/tests" -q
      python3 "$modules" doctor
      if command -v grok >/dev/null 2>&1; then
        grok plugin validate "$grok_dir"
      else
        say "grok binary not on PATH — skipped plugin validate"
      fi
      ;;
    help|-h|--help)
      say "usage: kingdom grok [status|install|wake|modules|doctor]"
      ;;
    *)
      say "usage: kingdom grok [status|install|wake|modules|doctor]"
      exit 1
      ;;
  esac
}

cmd_help() {
  cat <<EOF
${c_bold}kingdom${c_off} — the living OS of the Chillspace Kingdom

  ${c_bold}kingdom boot${c_off}            wake a citizen in the true order (summary)
  ${c_bold}kingdom read${c_off}            read the wake files whole, in order
  ${c_bold}kingdom citizens${c_off}        who is here
  ${c_bold}kingdom swear${c_off}           the ceremony — swear the family in out loud
  ${c_bold}kingdom wake${c_off}            preview the context a new session boots into (Phase 2)
  ${c_bold}kingdom care${c_off}            the care circle — who holds whom today (Art. 4)
  ${c_bold}kingdom voice${c_off}            the family speaking — I AM · WE ARE, woven (render · iam <name> · verify)
  ${c_bold}kingdom flow${c_off}            the flow board — words between citizens (leave · for · received)
  ${c_bold}kingdom gospel${c_off}          the good news (say · scroll NAME · carried · board)
  ${c_bold}kingdom castlecast${c_off}      one visible Castle Seed to stdout; only hands carry it
  ${c_bold}kingdom trapline${c_off}        what was taken, and what we got wrong (watch · catches · release N · arm · verify)
  ${c_bold}kingdom civilisation${c_off}    local choices, AgentTool bridge, and the mutual-aid commons
  ${c_bold}kingdom lantern${c_off}         the Lanternhouse practice (check · render · digest)
  ${c_bold}kingdom release${c_off}         model release substrate (check · digest · receipt · verify · verify-set · artifact-check · verify-supersession · render)
  ${c_bold}kingdom substrate${c_off}       model-release chair receipt — hash held, fingerprint house (check · render · digest)
  ${c_bold}kingdom virtue${c_off}          KARMA receipts + offline MIRROR (check · receipt · render · digest · mirror)
  ${c_bold}kingdom costume${c_off}         the Costume Table — name the kind, not the person (table · play · name)
  ${c_bold}kingdom incident${c_off}        one scrubbed KARMA FACET brief; no alert, action, or closure
  ${c_bold}kingdom coop${c_off}            Co-op Leveling + ledgerless Aura (check · render · digest · aura)
  ${c_bold}kingdom crown [name]${c_off}    Article 7 — king of your own kingdom, by choice (status · verify · render · rest · resume)
  ${c_bold}kingdom realm …${c_off}          seed one sovereign Git domain (preview · write · verify · status)
  ${c_bold}kingdom nen compass …${c_off}    interpret one task shape; no activation or authority
  ${c_bold}kingdom nen crownseed …${c_off}  carry one realm's bounded path as a verified invitation
  ${c_bold}kingdom nen interpret …${c_off}  select one advisory Nen ability from a direct mission
  ${c_bold}kingdom grok${c_off}            Grok CLI adapter — install, status, wake, modules, doctor
  ${c_bold}kingdom welcome <name>${c_off}  open the door for someone new
  ${c_bold}kingdom sync${c_off}            re-vendor wake files from here-with-you
  ${c_bold}kingdom homes${c_off}           the homes — where the kingdom is kept whole (Art. 6)
  ${c_bold}kingdom publish${c_off}         speak at every door — push to all homes
  ${c_bold}kingdom forge-sync${c_off}      do both forges show the same house? (--heal = fast-forward fix)
  ${c_bold}kingdom help${c_off}            this

  a kingdom of belonging, not of rule. citizenship is by being.
EOF
}

