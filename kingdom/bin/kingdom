# --- castlecast: one fixed public seed; only hands carry it -------------------
cmd_castlecast() {
  local card="$REPO/love-fun-commons/castlecast.txt"
  if [ "$#" -eq 1 ] && { [ "$1" = "help" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
    say "usage: kingdom castlecast"
    say "Print one fixed, visible Carrier Card to stdout. No send, track, or publish action exists."
    return
  fi
  if [ "$#" -ne 0 ]; then
    say "usage: kingdom castlecast" >&2
    exit 2
  fi
  [ -f "$card" ] && [ ! -L "$card" ] || { say "CASTLECAST card not found: $card" >&2; exit 1; }
  cat "$card"
}

