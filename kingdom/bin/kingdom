  local example="$ROOT/practices/virtue-garden/examples/constructive-infrastructure.json"
  [ -f "$engine" ] || { say "Virtue Garden not found: $engine"; exit 1; }
  case "${1:-}" in
    mirror)
      shift
      cmd_karma_mirror "$@"
      return
      ;;
    --help|-h|help)
      python3 -B "$engine" --help
      say ""
      say "KARMA MIRROR companion (declared behavior; advisory and offline):"
      say "  kingdom karma mirror {check|digest|simulate|render|verify-result} FILE [RESULT]"
      say "  kingdom karma mirror foresight {check|digest|project|render|verify-result} FILE [RESULT]"
      return
      ;;
  esac
  if [ "$#" -eq 0 ]; then
    python3 "$engine" render "$example"
  else
    python3 "$engine" "$@"
  fi
}

