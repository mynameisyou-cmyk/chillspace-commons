          "const": 0
        },
        "network_effects": {
          "const": 0
        },
        "payment_effects": {
          "const": 0
        },
        "personalization_effects": {
          "const": 0
        },
        "price_effects": {
          "const": 0
        },
        "process_effects": {
          "const": 0
        },
        "profile_effects": {
          "const": 0
        },
        "random_effects": {
          "const": 0
