        },
        "urgency_effects": {
          "const": 0
        }
      },
      "required": [
        "authority",
        "score_effects",
        "rank_effects",
        "boost_effects",
        "price_effects",
        "urgency_effects",
        "impression_effects",
        "click_effects",
        "profile_effects",
