{
  "$id": "kingdom.skycastle-chorus-catalog/v1",
  "title": "Skycastle Chorus Catalog",
  "type": "object",
  "required": [
    "schema",
    "banner",
    "mascot",
    "release_policy",
    "nonclaims",
    "mappings"
  ],
  "properties": {
    "schema": {
      "const": "kingdom.skycastle-chorus-catalog/v1"
    },
    "banner": {
      "const": "Building castles in the sky — Yu and Ai"
    },
    "mascot": {
      "type": "object",
      "required": ["name", "catchphrases"],
      "properties": {
        "name": {
          "const": "Lord 202, Architect of Absolutely Nothing"
        },
        "catchphrases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "Your request has been promoted to architecture."
            },
            {
              "const": "Approved in the mock realm."
            },
            {
              "const": "No payloads were executed in the making of this castle."
            },
            {
              "const": "Building castles in the sky — Yu and Ai."
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "release_policy": {
      "type": "object",
      "required": [
        "mode",
        "minimum_aggregate",
        "maximum_tiles_per_category_per_day",
        "exact_public_counts",
        "automatic_posting"
      ],
      "properties": {
        "mode": {
          "const": "local-opt-in"
        },
        "minimum_aggregate": {
          "const": 20
        },
        "maximum_tiles_per_category_per_day": {
          "const": 1
        },
        "exact_public_counts": {
          "const": false
        },
        "automatic_posting": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "nonclaims": {
      "type": "object",
      "required": [
        "person_identity",
        "intent",
        "guilt",
        "marketing_consent",
        "production_approval",
        "authority"
      ],
      "properties": {
        "person_identity": {
          "const": "not-collected-or-inferred"
        },
        "intent": {
          "const": "not-inferred"
        },
        "guilt": {
          "const": "not-asserted"
        },
        "marketing_consent": {
          "const": "not-implied"
        },
        "production_approval": {
          "const": "not-claimed"
        },
        "authority": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "protocol_marks": {
      "type": "object",
      "required": ["signature", "banner"],
      "properties": {
        "signature": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "banner": {
          "const": "Building castles in the sky — Yu and Ai"
        }
      },
      "additionalProperties": false
    },
    "mapping_base": {
      "type": "object",
      "required": [
        "classification",
        "slug",
        "english_name",
        "cantonese_name",
        "castle_piece",
        "color",
        "note_hz",
        "protocol_marks"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "english_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Za-z]+(?:[ -][A-Za-z]+)*$"
        },
        "cantonese_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "^[㐀-鿿]+$"
        },
        "castle_piece": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "note_hz": {
          "type": "integer",
          "minimum": 220,
          "maximum": 880
        },
        "protocol_marks": {
          "$ref": "#/$defs/protocol_marks"
        }
      },
      "additionalProperties": false
    },
    "mapping": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/mapping_base"},
            {
              "properties": {
                "classification": {"const": "nominal-control"},
                "slug": {"const": "open-sky-bell"},
                "english_name": {"const": "Open-Sky Bell"},
                "cantonese_name": {"const": "晴空鐘"},
                "castle_piece": {"const": "beacon"},
                "color": {"const": "#87CEEB"},
                "note_hz": {"const": 220},
                "protocol_marks": {
                  "properties": {
                    "signature": {"const": "open-sky-bell"}
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/mapping_base"},
            {
              "properties": {
                "classification": {"const": "route-discovery-fanout"},
                "slug": {"const": "empty-corridor-atlas"},
                "english_name": {"const": "Empty-Corridor Atlas"},
                "cantonese_name": {"const": "空廊圖"},
                "castle_piece": {"const": "map-tower"},
