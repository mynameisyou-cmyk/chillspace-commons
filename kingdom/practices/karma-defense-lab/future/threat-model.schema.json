{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kingdom.karma.threat-model/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_id",
    "scope",
    "nonclaims",
    "classes"
  ],
  "properties": {
    "schema": {
      "const": "kingdom.karma.threat-model/v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "scope": {
      "const": "offline-synthetic-planning-only"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^[ -~]+$"
      }
    },
    "classes": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "entry_point",
          "assets",
          "prevention",
          "detection",
          "containment",
          "recovery",
          "privacy_output",
          "evidence_status",
          "test_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[ -~]+$"
          },
          "entry_point": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[ -~]+$"
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[ -~]+$"
            }
          },
          "prevention": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[ -~]+$"
          },
          "detection": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[ -~]+$"
          },
          "containment": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[ -~]+$"
          },
          "recovery": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[ -~]+$"
          },
          "privacy_output": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[ -~]+$"
          },
          "evidence_status": {
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "test_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    }
  }
}
