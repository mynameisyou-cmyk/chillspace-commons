{
  "$id": "kingdom.skycastle-chorus-manifest/v1",
  "title": "Skycastle Chorus Safe Artifact Manifest",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "status",
    "source",
    "bindings",
    "banner",
    "mascot",
    "release_policy",
    "tiles",
    "effects",
    "nonclaims",
    "content_digest",
    "artifacts",
    "manifest_digest"
  ],
  "properties": {
    "schema": {
      "const": "kingdom.skycastle-chorus-manifest/v1"
    },
    "engine": {
      "const": "skycastle-chorus/1"
    },
    "status": {
      "const": "local-preview"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "banner": {
      "const": "Building castles in the sky — Yu and Ai"
    },
    "mascot": {
      "$ref": "#/$defs/mascot"
    },
    "release_policy": {
      "$ref": "#/$defs/release_policy"
    },
    "tiles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/tile_01"},
        {"$ref": "#/$defs/tile_02"},
        {"$ref": "#/$defs/tile_03"},
        {"$ref": "#/$defs/tile_04"},
        {"$ref": "#/$defs/tile_05"},
        {"$ref": "#/$defs/tile_06"},
        {"$ref": "#/$defs/tile_07"},
        {"$ref": "#/$defs/tile_08"},
        {"$ref": "#/$defs/tile_09"},
        {"$ref": "#/$defs/tile_10"}
      ],
      "items": false
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "nonclaims": {
      "$ref": "#/$defs/nonclaims"
    },
    "content_digest": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "manifest_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "scenario",
        "canary_digest",
        "receipt_digest",
        "core_engine_sha256"
      ],
      "properties": {
        "scenario": {
          "const": "traditional-nine"
        },
        "canary_digest": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "core_engine_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [
        "renderer_sha256",
        "catalog_sha256",
        "catalog_schema_sha256",
        "manifest_schema_sha256",
        "core_rules_sha256"
      ],
      "properties": {
        "renderer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "core_rules_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "mascot": {
      "type": "object",
      "required": ["name", "catchphrases"],
      "properties": {
        "name": {
          "const": "Lord 202, Architect of Absolutely Nothing"
        },
        "catchphrases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "Your request has been promoted to architecture."
            },
            {
              "const": "Approved in the mock realm."
            },
            {
              "const": "No payloads were executed in the making of this castle."
            },
            {
              "const": "Building castles in the sky — Yu and Ai."
            }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "release_policy": {
      "type": "object",
      "required": [
        "mode",
        "minimum_aggregate",
        "maximum_tiles_per_category_per_day",
        "exact_public_counts",
        "automatic_posting"
      ],
      "properties": {
        "mode": {
          "const": "local-opt-in"
        },
        "minimum_aggregate": {
          "type": "integer",
          "not": {"type": "boolean"},
          "const": 20
        },
        "maximum_tiles_per_category_per_day": {
          "type": "integer",
          "not": {"type": "boolean"},
          "const": 1
        },
        "exact_public_counts": {
          "type": "boolean",
          "const": false
        },
        "automatic_posting": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "protocol_marks": {
      "type": "object",
      "required": [
        "signature_field",
        "signature_value",
        "banner_field",
        "banner_value"
      ],
      "properties": {
        "signature_field": {
          "const": "X-Skycastle-Signature"
        },
        "signature_value": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "banner_field": {
          "const": "X-Skycastle-Banner"
        },
        "banner_value": {
          "const": "Building-castles-in-the-sky--Yu-and-Ai"
        }
      },
      "additionalProperties": false
    },
    "tile_base": {
      "type": "object",
      "required": [
        "ordinal",
        "classification",
        "signature",
        "english_name",
        "cantonese_name",
        "castle_piece",
        "color",
        "note_hz",
        "protocol_marks"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "not": {"type": "boolean"},
          "minimum": 1,
          "maximum": 10
        },
        "classification": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "signature": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "english_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Za-z]+(?:[ -][A-Za-z]+)*$"
        },
        "cantonese_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "^[㐀-鿿]+$"
        },
        "castle_piece": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z]+(?:-[a-z]+)*$"
        },
        "color": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-F]{6}$"
        },
        "note_hz": {
          "type": "integer",
          "not": {"type": "boolean"},
          "minimum": 220,
          "maximum": 880
        },
        "protocol_marks": {
          "$ref": "#/$defs/protocol_marks"
        }
      },
      "additionalProperties": false
    },
    "tile_01": {
      "allOf": [
        {"$ref": "#/$defs/tile_base"},
        {
          "properties": {
            "ordinal": {"const": 1},
            "classification": {"const": "nominal-control"},
            "signature": {"const": "open-sky-bell"},
            "english_name": {"const": "Open-Sky Bell"},
            "cantonese_name": {"const": "晴空鐘"},
